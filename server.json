{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.dockndevai/mcp-azure-devops",
  "description": "Azure DevOps boards, repos, pipelines & projects for AI agents — governed.",
  "version": "0.1.1",
  "repository": {
    "url": "https://github.com/dockndevai/mcp-azure-devops",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@dockndevai/mcp-azure-devops",
      "version": "0.1.1",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "AZDO_ORG_URL",
          "description": "Azure DevOps organization URL, e.g. https://dev.azure.com/your-org.",
          "isRequired": true,
          "isSecret": false
        },
        {
          "name": "AZDO_PAT",
          "description": "Personal Access Token (read-only to start).",
          "isRequired": true,
          "isSecret": true
        },
        {
          "name": "AZDO_MODE",
          "description": "Access mode: read-only | read-write | admin.",
          "isRequired": false,
          "isSecret": false
        }
      ]
    }
  ]
}
