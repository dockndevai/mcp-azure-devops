# --- Connection -------------------------------------------------------------
# Either AZDO_ORG_URL (full) or AZDO_ORG (short name).
AZDO_ORG_URL=https://dev.azure.com/your-org
# AZDO_ORG=your-org
# Personal Access Token with the scopes you need (read-only PATs recommended to start).
AZDO_PAT=your-pat
AZDO_API_VERSION=7.1
AZDO_TIMEOUT_MS=20000

# --- Governance & security flags -------------------------------------------
# Access mode: read-only | read-write | admin. Start with read-only.
AZDO_MODE=read-only
# Comma-separated project allowlist. Empty = all projects.
AZDO_PROJECT_ALLOWLIST=
# Projects that can be read but never mutated/deleted.
AZDO_PROTECTED_PROJECTS=
# delete_project requires this in addition to admin mode.
AZDO_ALLOW_DELETE=false
# High-impact ops (delete_project) require a typed confirmation matching the name.
AZDO_REQUIRE_CONFIRMATION=true
# Validate + log writes without sending them to Azure DevOps.
AZDO_DRY_RUN=false
# Emit a JSON audit line to stderr per guarded operation.
AZDO_AUDIT_LOG=true

# --- AI risk guard (optional; needs a running laya-guard daemon) -------------
# High-risk ops ask a LOCAL laya-guard daemon to classify them allow / confirm / block. Runs AFTER
# the deterministic gates; only tightens, never grants; fails closed.  off | monitor | enforce
AZDO_GUARD_MODE=off
AZDO_GUARD_URL=http://127.0.0.1:8799
AZDO_GUARD_TIMEOUT_MS=2000
AZDO_GUARD_FAIL_CLOSED=confirm
